# PashuSetu Environment Variables

# Backend Configuration
PROJECT_NAME="PashuSetu — Smart Livestock Hub"
SECRET_KEY=change-this-to-a-secure-random-jwt-secret-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# For local SQLite development (default out-of-the-box):
DATABASE_URL=sqlite:///./pashusetu.db

# For PostgreSQL + PostGIS (Docker or Cloud):
# DATABASE_URL=postgresql://pashu_user:pashu_password_secure@localhost:5432/pashusetu

# Synthetic Demo Mode (Set to true to seed demonstrative data)
SEED_DEMO_DATA=true

# Frontend Configuration (when deployed separately)
VITE_API_BASE_URL=http://localhost:8000/api
